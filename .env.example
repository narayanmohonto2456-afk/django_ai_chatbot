# Copy to .env and replace placeholders with your own local values.
# Generate SECRET_KEY locally; never copy a key from another project.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000/
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DB_NAME=your_database
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# Production: set DEBUG=False and configure real hosts/origins and HTTPS.
# Production session/CSRF cookies are Secure when DEBUG=False.
# Do not enable HSTS until HTTPS is working correctly.
